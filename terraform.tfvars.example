# ==============================================================================
# terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in your actual values.
# NEVER commit your actual terraform.tfvars to version control.
# ==============================================================================

# Target region (lowest latency to Nigeria among non-opt-in regions)
aws_region = "eu-west-1"

# Instance type: "m7i-flex.large", "c7i-flex.large", or "t3.small"
instance_type = "m7i-flex.large"

# Your current public IPv4 address with /32 mask.
# Find your IP via: curl -s https://checkip.amazonaws.com
# Example: "102.89.23.45/32"
allowed_ip = "203.0.113.15/32"

# Your public SSH key string (contents of ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExamplePublicKeyPlaceholder12345 user@workstation"

# Dedicated non-root desktop username
workstation_user = "dcvuser"

# Password for desktop/DCV remote authentication (minimum 12 characters)
dcv_password = "ReplaceWithAStrongSecretPassword2026!"

# Notification email for AWS Budget alerts (50%, 80%, 100%)
budget_notification_email = "devops-engineer@example.com"

# Monthly budget allowance in USD (to pace a $200 credit over 6 months)
monthly_budget_usd = 35.0
